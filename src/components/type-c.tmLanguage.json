{
  "name": "type-c",
  "scopeName": "source.type-c",
  "fileTypes": [
    "tc"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.type-c",
      "match": "\\b(ReturnType|array|as|bool|break|cfn|class|const|continue|coroutine|do|else|enum|extern|f32|f64|fn|for|foreach|from|i16|i32|i64|i8|if|impl|import|in|interface|is|let|local|match|mut|mutate|namespace|never|new|override|prototype|return|static|string|struct|this|throw|type|u16|u32|u64|u8|unreachable|variant|void|while|yield)\\b|\\b(as!|as\\?|yield!)\\B"
    },
    {
      "name": "string.quoted.double.type-c",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.type-c",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.type-c"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.type-c"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.type-c"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.type-c"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.type-c",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
